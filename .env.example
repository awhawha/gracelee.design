# Server-only keys. Never prefix these with NEXT_PUBLIC_.

# Anthropic (preferred)
ANTHROPIC_API_KEY=
# Optional model override
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenAI (used only if ANTHROPIC_API_KEY is unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: point the static GitHub Pages site at a hosted Route Handler
# NEXT_PUBLIC_GRACE_LLM_ENDPOINT=https://your-deployment.vercel.app/api/grace-llm

# Optional: disable static export so `next build` keeps /api/grace-llm
# DISABLE_STATIC_EXPORT=true
